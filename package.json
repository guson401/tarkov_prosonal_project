{
  "name": "tarkov-companion-workspace",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/desktop",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run tauri:dev --workspace @tarkov/desktop",
    "build": "npm run build --workspace @tarkov/desktop",
    "tauri:dev": "npm run tauri:dev --workspace @tarkov/desktop",
    "tauri:build": "npm run tauri:build --workspace @tarkov/desktop"
  }
}
